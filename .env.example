APP_ENV=local

# Database selection
DATABASE_PROVIDER=postgres
DATABASE_URL=postgresql+psycopg://poc_user:poc_password@localhost:5432/ai_data_quality_poc

# Local Postgres container defaults
POSTGRES_DB=ai_data_quality_poc
POSTGRES_USER=poc_user
POSTGRES_PASSWORD=poc_password
POSTGRES_PORT=5432

# LLM provider placeholders (not active in skeleton stage)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=replace_me

# Static pricing placeholders
INPUT_TOKEN_PRICE_USD_PER_1K=0.00015
OUTPUT_TOKEN_PRICE_USD_PER_1K=0.0006
